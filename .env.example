# Groq API Keys - Get from https://console.groq.com
# Option 1: Single key (legacy)
GROQ_API_KEY=your_groq_api_key_here

# Option 2: Multiple keys for failover (recommended)
GROQ_API_KEY_1=your_first_groq_api_key_here
GROQ_API_KEY_2=your_second_groq_api_key_here
GROQ_API_KEY_3=your_third_groq_api_key_here

# Chroma DB Configuration
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=neuraflux_kb

# CORS Configuration - Comma-separated allowed origins
ALLOWED_ORIGINS=https://neuraflux.io,http://localhost:3000

# Optional: API settings
API_HOST=0.0.0.0
API_PORT=8000
